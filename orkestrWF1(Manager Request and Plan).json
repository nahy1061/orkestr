      "id": "773581ed-610f-4632-a05e-c56fd4bb9ba2",
      "name": "Understand the User's intent/request"
    },
    {
      "parameters": {
        "jsCode": "// Get the original request from the Webhook node.\nconst request = $('Webhook:recieve the request').first().json.body ?? {};\nconst message = String(request.message ?? '');\n\n// Information Extractor output commonly appears under \"output\".\n// Inspect your actual node output and adjust this line if needed.\nconst raw = $json.output ?? $json;\n\n// Only allow known actions.\nlet action = raw.action;\nif (!['plan_cancellations', 'question', 'unclear'].includes(action)) {\n  action = 'unclear';\n}\n\n// Convert the extracted duration into a number.\nlet days = Number(raw.days);\n\n// Backup: extract an explicit number from the user's message.\n// This only works for numeric phrases like \"5 days\".\nconst match = message.match(/\\b(\\d+)\\s*days?\\b/i);\n\nif ((!Number.isFinite(days) || days <= 0) && match) {\n  days = Number(match[1]);\n}\n\n// Never invent a duration.\n// A planning request without a valid duration is sent to clarification.\nif (\n  action === 'plan_cancellations' &&\n  (!Number.isInteger(days) || days < 1 || days > 365)\n) {\n  action = 'unclear';\n}\n\nreturn {\n  json: {\n    action,\n    days: action === 'plan_cancellations' ? days : null,\n    message,\n    session_id: request.session_id ?? 'web'\n  }\n};"
      },
